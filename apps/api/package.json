{
  "name": "@sba/api",
  "version": "0.0.0",
  "private": true,
  "description": "Central API \u2014 Secretariat, Syndic, Lawyer and Public endpoints (NestJS)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
