{
  "name": "sba-governance",
  "version": "0.0.0",
  "private": true,
  "description": "Syrian Bar Association — Executive Governance & Smart Booking System",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @sba/shared build && pnpm -r --parallel run dev",
    "typecheck": "pnpm --filter @sba/shared build && pnpm -r run typecheck",
    "lint": "pnpm --filter @sba/shared build && eslint .",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
