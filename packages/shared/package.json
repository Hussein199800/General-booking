{
  "name": "@sba/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Domain constants, i18n (Arabic) and types shared by the API and the web app",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./locales/ar.json": "./locales/ar.json"
  },
  "files": [
    "dist",
    "locales"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  }
}
