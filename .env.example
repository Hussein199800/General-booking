# =============================================================================
# Syrian Bar Association — environment template
# Copy to `.env` (git-ignored) and replace every CHANGE_ME value.
# Generate strong values with:  openssl rand -base64 32
# Each block notes the phase whose code starts reading it.
# =============================================================================

# --- Docker Compose infrastructure (Phase 0) ---------------------------------
POSTGRES_DB=sba
POSTGRES_USER=sba_owner
POSTGRES_PASSWORD=CHANGE_ME
# Runtime role `sba_app` (DML only) — the API connects with this.
POSTGRES_APP_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

MINIO_ROOT_USER=sba-minio-root
MINIO_ROOT_PASSWORD=CHANGE_ME_AT_LEAST_8_CHARS
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_DOCUMENTS=sba-documents
# Least-privilege account the API uses (created by the minio-init job).
MINIO_APP_ACCESS_KEY=sba-api
MINIO_APP_SECRET_KEY=CHANGE_ME_AT_LEAST_8_CHARS

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Optional self-hosted Jitsi (docker compose --profile jitsi) -------------
JITSI_IMAGE_VERSION=stable
JITSI_PUBLIC_URL=https://localhost:8443
JITSI_JWT_APP_ID=sba
JITSI_JWT_APP_SECRET=CHANGE_ME
JITSI_JICOFO_AUTH_PASSWORD=CHANGE_ME
JITSI_JVB_AUTH_PASSWORD=CHANGE_ME
JITSI_JVB_ADVERTISE_IPS=127.0.0.1

# --- API (Phase 0) ------------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (Phase 1) -------------------------------------------------------
# Runtime role has DML only; migrations and the seed run as the owner role.
DATABASE_URL=postgresql://sba_app:CHANGE_ME@127.0.0.1:5432/sba
DATABASE_MIGRATION_URL=postgresql://sba_owner:CHANGE_ME@127.0.0.1:5432/sba
# Key material lives in files, never inline. `pnpm secrets:dev` creates dev values.
PII_HMAC_PEPPER_FILE=./infra/secrets/pii-hmac-pepper
MASTER_KEYS_FILE=./infra/secrets/master-keys.json
MASTER_KEY_ACTIVE_ID=kek-dev-01
# Demo users + demo room (refused when NODE_ENV=production).
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARS

# --- API runtime, auth and sessions (Phase 2) -------------------------------
JWT_SIGNING_KEY_FILE=./infra/secrets/jwt-signing-key
ACCESS_TOKEN_TTL_SECONDS=600
SESSION_IDLE_TTL_SECONDS=43200
SESSION_ABSOLUTE_TTL_SECONDS=604800
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Leave unset: Secure cookies in production. Set to false only for plain-http local dev.
COOKIE_SECURE=false
TRUST_PROXY_HOPS=1
PUBLIC_BASE_URL=http://localhost:3000
# Self-hosted Jitsi; remote meetings are refused while unset.
JITSI_PUBLIC_URL=https://localhost:8443

# --- Queues, storage, crypto, providers (Phase 3) ----------------------------
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
SIGNED_URL_TTL_SECONDS=300
MEETING_PROVIDER=jitsi
SMS_PROVIDER=console
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@localhost
